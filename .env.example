# Copy to apps/web/.env.local; never commit actual values.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_SERVER_SECRET_KEY
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_PRIVATE_KEY_BASE64=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# openssl rand -hex 32 (64 hexadecimal characters)
APP_ENCRYPTION_KEY=
# Exact chrome-extension://ID origins, comma-separated; empty denies extensions.
ALLOWED_EXTENSION_ORIGINS=
# For migration tooling ONLY, use URL-encoded password and sslmode=verify-full.
DATABASE_URL=
